# PostgreSQL connection (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Google Gemini (optional — server-side only, never exposed to the browser)
# GEMINI_API_KEY=your-key
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_FALLBACK_MODELS=gemini-1.5-flash,gemini-1.5-flash-8b
# GEMINI_TIMEOUT_MS=25000

# Set to "false" to stop returning verification / reset links in API responses
# EVOLNEX_DEV_LINKS=true
